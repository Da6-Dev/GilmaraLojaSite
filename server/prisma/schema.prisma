// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// 1. Defina o provedor do banco de dados como PostgreSQL
datasource db {
  provider = "postgresql"
}

// 2. Exemplo de um modelo/tabela para sua aplicação
model Produto {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(255)
  descricao String?
  preco     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Adicione mais modelos conforme a necessidade da sua loja (ex: User, Pedido, Categoria)
